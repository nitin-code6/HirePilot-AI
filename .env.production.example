# Production Environment Variables Example for HirePilot AI

# Application Environment
APP_ENV=production
DEBUG=False
BACKEND_URL=https://api.hirepilot.yourdomain.com
FRONTEND_URL=https://hirepilot.yourdomain.com

# PostgreSQL (e.g. Neon, Supabase, or AWS RDS)
DATABASE_URL=postgresql+asyncpg://hirepilot_user:strong_production_password@ep-sample-1234.us-east-2.aws.neon.tech/hirepilot_db

# Managed Redis (e.g. Upstash or Redis Cloud)
REDIS_URL=rediss://default:sample_token@sample-redis.upstash.io:6379

# Cryptographic Keys (Generate with `openssl rand -hex 32`)
SECRET_KEY=generate_a_very_secure_random_hex_32_bytes_string
JWT_SECRET_KEY=generate_another_very_secure_random_hex_32_bytes_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Services
GROQ_API_KEY=gsk_your_groq_production_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_production_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=hirepilot-ai-production

# Email Delivery (SendGrid, Amazon SES, or Mailgun SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_production_api_key
EMAIL_FROM=notifications@hirepilot.yourdomain.com

# Google OAuth & Calendar Integration
GOOGLE_CLIENT_ID=your_google_cloud_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_cloud_client_secret
GOOGLE_REDIRECT_URI=https://api.hirepilot.yourdomain.com/api/v1/integrations/google/callback

# File Storage
UPLOAD_DIR=/var/data/hirepilot/uploads
MAX_UPLOAD_SIZE_MB=15
